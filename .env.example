# Copy this file to .env for local development, or set these as
# Environment Variables in your Vercel project settings for deployment.
# Never commit the real .env file, it's already in .gitignore.

# From notion.so/my-integrations, the "Internal Integration Secret"
NOTION_TOKEN=ntn_your_integration_secret_here

# The Tasks database ID. Open Tasks in Notion, copy its URL, the ID is
# the 32-character string right after your workspace name and before any
# "?v=" in the URL. Example URL:
#   https://notion.so/myworkspace/1a2b3c4d5e6f47a8b9c0d1e2f3a4b5c6?v=...
# The ID there is: 1a2b3c4d5e6f47a8b9c0d1e2f3a4b5c6
TASKS_DATABASE_ID=

# The Capture page ID, found the same way, from the Capture page's own URL.
CAPTURE_PAGE_ID=

# The passcode you'll type into the app itself before it shows anything.
# Make this up yourself, doesn't need to match anything else.
APP_PASSWORD=

# Google Calendar integration, OPTIONAL. Leave all three blank and the
# "Add to calendar" button simply doesn't appear on the Capture screen.
# Only needed if you want that button. From console.cloud.google.com: create
# an OAuth 2.0 Client ID (type "Web application"), that gives you the
# first two values below. The refresh token is obtained once through a
# manual consent flow (see README.md for the exact steps), it lets the
# server create events on your calendar indefinitely without you having
# to log in again.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
